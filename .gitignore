# Environment files (contain secrets). The glob also covers editor/manual
# backups like .env.bak, which carry real keys but were not matched by ".env".
.env
.env.*
!.env.example

# Deploy target config: host, key path, secrets-hook path. No credentials, but
# it is the infrastructure topology this repo was scrubbed of — keep it out.
.deploy.env

# Git worktrees
.worktrees/

# Personal infrastructure / per-host documentation
docs/CLAUDE_*.md

# Point-in-time analysis reports (regenerable from prod DB)
docs/reports/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
ENV/

# IDE
.idea/
.vscode/
*.swp
*.swo

# Database backups
backups/

# OS
.DS_Store
Thumbs.db

# Local working notes holding personal context. This repo is PUBLIC — keep
# anything with real names, roles or infrastructure detail out of it.
claude-legacy-memory.md
