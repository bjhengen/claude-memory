# Claude Memory Configuration
# Copy this to .env and fill in your values

# Database password (change this!)
POSTGRES_PASSWORD=your_secure_password_here

# OpenAI API key for embeddings
OPENAI_API_KEY=sk-your-openai-key-here

# Anthropic API key for the consolidation judge (v5+)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Production only: public host the server is served under, behind nginx/TLS.
# Required in prod so DNS-rebinding protection accepts requests to this host.
# PUBLIC_HOST=memory.example.com
# OAUTH_ISSUER_URL=https://memory.example.com

# OAuth /approve consent-page gate. A POST to /approve issues an access token,
# so the page requires this passphrase (typed by you) before approving a new
# client. If APPROVE_PASSPHRASE is unset the endpoint fails closed — it approves
# nothing. APPROVE_COOKIE_SECRET (high-entropy, e.g. `openssl rand -hex 32`)
# signs the "remember this browser for 90 days" cookie. In production both live
# in the secrets manager, not here. Left blank on purpose: the gate rejects
# these sample/placeholder values and fails closed, so fill real values (or set
# them in the secrets manager) before relying on OAuth.
APPROVE_PASSPHRASE=
APPROVE_COOKIE_SECRET=
